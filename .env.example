# Chép file này thành .env (cùng thư mục) rồi điền khóa thật. File .env đã nằm trong .gitignore.

# ── Vbee TTS (chỉ cần khi chạy --tts vbee hoặc audio.provider = "vbee") ──
# Lấy App ID và Access Token trong trang quản lý API của tài khoản Vbee (https://vbee.vn).
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=

# Giọng đọc và tốc độ Vbee đặt trong config/settings.json → audio.vbee:
#   voice_code  vd: n_hanoi_male_protrainer_education_vc (Nam Hà Nội) · n_hanoi_female_nguyetnga2_book_vc (Nữ Hà Nội, đọc sách)
#               · s_sg_male_thientam_ytstable_vc (Nam Sài Gòn). Danh sách giọng tài khoản bạn dùng được: xem trên vbee.vn.
#   speed_rate  0.1 – 1.9, mặc định 1.0
